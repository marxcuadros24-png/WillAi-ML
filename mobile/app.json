{
  "expo": {
    "name": "WillAI Coracora",
    "slug": "willai-coracora",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pe.willai.coracora",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WillAI necesita tu ubicación GPS para georreferenciar reportes de incendios forestales en Parinacochas."
      }
    },
    "android": {
      "package": "pe.willai.coracora",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#080c14"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#ef4444"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@maplibre/maplibre-react-native",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "WillAI necesita acceder a tus fotos para adjuntar evidencia de incendios.",
          "cameraPermission": "WillAI necesita usar la cámara para tomar fotos del incendio forestal en tiempo real."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WillAI requiere acceso al GPS para capturar coordenadas exactas del fuego."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alerta.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "dc8b7900-4631-43bc-b5c8-6df274c898eb"
      }
    },
    "owner": "rodrigo_retamozo"
  }
}
